---
import "../styles/global.css";
import BackgroundWave from '../components/backgrounds/BackgroundWave.astro';

const {
  title = "Kye Murphy",
  description = "Cyber Security & Electronic Warfare",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} />

    <title>{title}</title>
  </head>

  <body>
    <slot />

    <BackgroundWave />
  </body>

</html>