---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import ModeSwitcher from "../components/ModeSwitcher.astro";
import SiteStatus from "../components/SiteStatus.astro";

---

<BaseLayout
  title="Kye Murphy"
  description="Electronic Warfare & Cyber Security"
>
  <main class="container">
    <header>
      <p class="prompt">~ $ whoami</p>

      <h1>Kye Murphy</h1>
      <h2>Electronic Warfare @ SRC Aus</h2>

      <div class="info">
        <p><span>education</span> Bachelor of Cyber Security</p>
        <p><span>location</span> Adelaide, AU</p>
      </div>
    </header>

    <nav class="link-grid" aria-label="Links">
      <div class="links">
        <a href="https://linkedin.com/in/kyemurphy">LinkedIn</a>
        <a href="https://github.com/kyealexander">GitHub</a>
        <a href="mailto:kye@kyemurphy.com">Email</a>
      </div>

      <div class="links secondary-links">
        <a href="/pgp">PGP</a>
      </div>
    </nav>
  </main>

  <SiteStatus />
  
  <div class="display-controls">
    <ThemeSwitcher />
    <ModeSwitcher />
  </div>

</BaseLayout>