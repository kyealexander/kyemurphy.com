---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import SiteStatus from "../components/SiteStatus.astro";

---

<BaseLayout
  title="Kye Murphy"
  description="Electronic Warfare & Cyber Security"
>
  <main class="container">
    <header>
      <p class="prompt">~ $ whoami</p>

      <h1>Kye Murphy</h1>
      <h2>Electronic Warfare @ SRC Aus</h2>

      <div class="info">
        <p><span>education</span> Bachelor of Cyber Security</p>
        <p><span>location</span> Adelaide, AU</p>
      </div>
    </header>

    <nav class="links" aria-label="Social links">
      <a
        href="https://linkedin.com/in/kyemurphy"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>

      <a
        href="https://github.com/kyealexander"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>

      <a href="mailto:kye@kyemurphy.com">
        Email
      </a>
    </nav>
  </main>

  <SiteStatus />
  <ThemeSwitcher />
</BaseLayout>