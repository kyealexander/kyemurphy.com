<button
  class="theme-switcher"
  id="theme-switcher"
  type="button"
>
  [ theme: sakura ]
</button>

<script>
  const themes = [
    { name: "sakura", color: "#ff3864" },
    { name: "arcade", color: "#41ff9a" },
    { name: "electric", color: "#38bdf8" },
    { name: "violet", color: "#c084fc" },
    { name: "lantern", color: "#ffbd2e" },
  ];

  const root = document.documentElement;
  const button = document.querySelector("#theme-switcher");

  const savedTheme = localStorage.getItem("theme") ?? "sakura";

  let currentIndex = themes.findIndex(
    (theme) => theme.name === savedTheme
  );

  if (currentIndex === -1) {
    currentIndex = 0;
  }

  function applyTheme() {
    const theme = themes[currentIndex];

    root.style.setProperty("--accent-color", theme.color);

    if (button) {
      button.textContent = `[ theme: ${theme.name} ]`;
    }

    localStorage.setItem("theme", theme.name);
    document.dispatchEvent(new CustomEvent("themechange", { detail: theme.color }));
  }

  function cycleTheme() {
    currentIndex = (currentIndex + 1) % themes.length;
    applyTheme();
  }

  applyTheme();

  button?.addEventListener("click", cycleTheme);

  document.addEventListener("keydown", (event) => {
    const target = event.target;

    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement
    ) {
      return;
    }

    if (event.key.toLowerCase() === "t") {
      cycleTheme();
    }
  });
</script>